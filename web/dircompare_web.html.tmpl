<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>双目录文件比对（本地网页版）</title>
<style>
  :root{--bg:#0f1117;--card:#171a23;--bd:#272d3d;--fg:#e6e8ef;--mut:#8b91a7;--acc:#4f8cff;--ok:#2ecc71;--warn:#f5b041;--err:#e74c3c}
  *{box-sizing:border-box}
  body{margin:0;font:14px/1.6 -apple-system,'Segoe UI','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--fg);padding:24px;min-height:100vh}
  h1{margin:0 0 2px;font-size:22px}
  .meta{color:var(--mut);font-size:12.5px;margin-bottom:16px}
  .zones{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
  .zone{background:var(--card);border:2px dashed #3a4258;border-radius:12px;padding:14px;transition:border-color .15s,background .15s;min-height:118px}
  .zone.drag{border-color:var(--acc);background:#121a2c}
  .zone.have{border-style:solid;border-color:#2c5b8f}
  .zt{font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px}
  .zt .tag{font-size:11px;background:#10203a;color:var(--acc);padding:1px 8px;border-radius:99px}
  .zd{color:var(--mut);font-size:13px}
  .zd .pick{background:#1b2133;border:1px solid var(--bd);color:var(--fg);border-radius:8px;padding:4px 12px;cursor:pointer;font-size:13px}
  .zd .pick:hover{border-color:var(--acc)}
  .zin{color:var(--acc);font-size:12.5px;margin-top:8px;word-break:break-all;font-family:Consolas,monospace}
  .zin .n{color:var(--fg)}
  .ctrl{display:flex;align-items:center;gap:10px;margin-bottom:6px;flex-wrap:wrap}
  .ctrl select,.ctrl button{background:#1b2133;border:1px solid var(--bd);color:var(--fg);border-radius:8px;padding:7px 14px;font-size:14px;cursor:pointer}
  .ctrl select:focus,.ctrl button:focus{outline:none;border-color:var(--acc)}
  #run{background:linear-gradient(180deg,#2b6de0,#1f56b8);border-color:#2b6de0;font-weight:700;padding:7px 22px}
  #run:disabled{opacity:.45;cursor:not-allowed}
  #status{color:var(--mut);font-size:12.5px}
  #progwrap{height:8px;background:#1b2133;border-radius:99px;overflow:hidden;margin:8px 0 4px}
  #prog{height:100%;width:0%;background:linear-gradient(90deg,#2b6de0,#7cc0ff);transition:width .12s;border-radius:99px}
  #plabel{color:var(--mut);font-size:12px;margin-bottom:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
  .chip{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:7px 12px;min-width:108px;text-align:center}
  .chip .v{font-size:16px;font-weight:700;color:var(--acc)}
  .chip .k{font-size:11px;color:var(--mut)}
  .toolbar{margin-bottom:10px}
  #q{width:100%;padding:8px 12px;border-radius:9px;border:1px solid var(--bd);background:var(--card);color:var(--fg);font-size:14px}
  #q:focus{outline:none;border-color:var(--acc)}
  details.sec{background:var(--card);border:1px solid var(--bd);border-radius:10px;margin-bottom:10px;overflow:hidden}
  summary{cursor:pointer;padding:10px 14px;font-weight:600;user-select:none;list-style:none;display:flex;align-items:center;gap:8px}
  summary::-webkit-details-marker{display:none}
  summary::before{content:"▸";color:var(--mut);transition:transform .15s}
  details[open] summary::before{transform:rotate(90deg)}
  summary .t{flex:0 0 auto}
  summary .note{color:var(--mut);font-weight:400;font-size:11.5px}
  .hbadge{margin-left:auto;font-size:11px;padding:1px 10px;border-radius:99px;font-weight:600;flex:0 0 auto}
  .ok{background:#15301f;color:var(--ok)}.warn{background:#3a2c12;color:var(--warn)}
  .onlyA{background:#0f2138;color:var(--acc)}.onlyB{background:#2a1630;color:#c98cf5}.err{background:#3a1216;color:var(--err)}
  .tblwrap{overflow:auto;max-height:48vh;border-top:1px solid var(--bd)}
  table{border-collapse:collapse;width:100%;font-size:13px}
  th,td{text-align:left;padding:5px 14px;border-bottom:1px solid #20253a;white-space:nowrap}
  th{position:sticky;top:0;background:#1d2233;color:var(--mut);font-weight:600;font-size:12px;z-index:1}
  td{font-family:Consolas,monospace;font-size:12.5px}
  .dim{color:var(--mut)}
  .b-certain{color:var(--ok);border:1px solid #25603f;background:#10281b;border-radius:6px;padding:0 7px;font-size:11px}
  .b-guess{color:#c98cf5;border:1px solid #4a2d55;background:#22102b;border-radius:6px;padding:0 7px;font-size:11px}
  .b-same{color:var(--acc);border:1px solid #27406b;border-radius:6px;padding:0 7px;font-size:11px;margin-left:5px}
  .b-only{color:var(--mut);border:1px solid var(--bd);border-radius:6px;padding:0 7px;font-size:11px}
  tr.hide{display:none}
  footer{color:var(--mut);font-size:12px;margin-top:18px}
  #stout{white-space:pre-wrap;font-family:Consolas,monospace;font-size:12px;background:#0b0e14;border:1px solid var(--bd);border-radius:8px;padding:10px;margin-top:10px;display:none}
  #excsv{margin-left:auto}
  .rroots{color:var(--mut);font-size:12px;margin:0 0 2px;word-break:break-all}
</style>
</head>
<body>
<h1>双目录文件比对（本地网页版）</h1>
<div class="meta">纯浏览器本地运行：拖入两个文件夹（或点按钮选择），按大小分层 + SHA-256/SHA-1 哈希比对，文件不上传、无需服务器。底层逻辑与命令行版一致（“确定/推测”含义相同）。</div>

<div class="zones">
  <div class="zone" id="zA">
    <div class="zt">目录 A <span class="tag" id="tagA">未选择</span></div>
    <div class="zd">把文件夹拖到这里，或 <button class="pick" data-side="A">选择文件夹…</button>
      <input type="file" webkitdirectory id="inA" hidden></div>
    <div class="zin" id="infoA"></div>
  </div>
  <div class="zone" id="zB">
    <div class="zt">目录 B <span class="tag" id="tagB">未选择</span></div>
    <div class="zd">把文件夹拖到这里，或 <button class="pick" data-side="B">选择文件夹…</button>
      <input type="file" webkitdirectory id="inB" hidden></div>
    <div class="zin" id="infoB"></div>
  </div>
</div>

<div class="ctrl">
  <label>算法 <select id="algo"><option value="SHA-256">SHA-256</option><option value="SHA-1">SHA-1</option></select></label>
  <button id="run" disabled>▶ 开始比对</button>
  <button id="excsv" hidden>导出 CSV</button>
  <span id="status"></span>
</div>
<div id="progwrap" hidden><div id="prog"></div></div>
<div id="plabel" hidden></div>

<div id="results" hidden>
  <div class="rroots" id="rroots"></div>
  <div class="chips" id="chips"></div>
  <div class="toolbar"><input id="q" placeholder="🔍 过滤 —— 输入文件名任意部分，实时筛选下方各表" autocomplete="off"></div>
  <div id="secs"></div>
</div>
<pre id="stout"></pre>
<footer>提示：同名文件出现在“⚠ 同名但内容不同”表示两边同名文件实际内容不一致，删除/覆盖前留意。结果仅供人工决策，本页不会修改任何文件。支持的最大单文件受浏览器内存限制（一般数 GB 内没问题）。</footer>

<script>
/*__ENGINE__*/

"use strict";
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");

const state = { A: null, B: null, last: null };

/* ---------- 选择文件夹 ---------- */
function setZone(side, info) {
  const z = $("#z" + side);
  if (info) { z.classList.add("have"); z.classList.remove("drag"); }
  $("#tag" + side).textContent = info ? (info.folder || "已选择") : "未选择";
  $("#info" + side).innerHTML = info
    ? "<span class='n'>" + esc(info.folder) + "</span><br>" + info.n + " 个文件 · " + humanSize(info.bytes) + (info.z ? "（含 " + info.z + " 个 0 字节）" : "")
    : "";
  state[side] = info;
  $("#run").disabled = !(state.A && state.B);
}
function adapt(name, f) { return { name, size: f.size, read: () => f.arrayBuffer() }; }

document.querySelectorAll(".pick").forEach(btn => {
  btn.addEventListener("click", () => { const i = $("#in" + btn.dataset.side); i.value = ""; i.click(); });
});
$("#inA").addEventListener("change", e => setZone("A", infoFromFiles(e.target.files)));
$("#inB").addEventListener("change", e => setZone("B", infoFromFiles(e.target.files)));
function infoFromFiles(files) {
  if (!files.length) return null;
  const folder = files[0].webkitRelativePath.split("/")[0] || "选择文件夹";
  const list = [];
  for (const f of files) {
    const rel = f.webkitRelativePath || f.name;
    const name = rel.indexOf("/") >= 0 ? rel.slice(rel.indexOf("/") + 1) : f.name;
    list.push(adapt(name, f));
  }
  return summarize(sideName(folder), list);
}
function sideName(folder) {
  // 取纯文件夹名展示
  const p = folder.replace(/\\/g, "/").split("/");
  return p[p.length - 1];
}

/* ---------- 拖拽 ---------- */
["A", "B"].forEach(side => {
  const z = $("#z" + side);
  z.addEventListener("dragover", e => { e.preventDefault(); z.classList.add("drag"); });
  z.addEventListener("dragleave", () => z.classList.remove("drag"));
  z.addEventListener("drop", async e => {
    e.preventDefault(); z.classList.remove("drag");
    const item = [...(e.dataTransfer.items || [])].find(i => i.webkitGetAsEntry);
    if (!item) { setZone(side, null); return; }
    const entry = item.webkitGetAsEntry();
    if (!entry || !entry.isDirectory) { $("#status").textContent = "⚠ 请拖入整个文件夹"; return; }
    try {
      const list = await traverseDir(entry);
      setZone(side, summarize(entry.name, list));
    } catch (ex) { $("#status").textContent = "读取失败：" + (ex && ex.message || ex); }
  });
});
function traverseDir(rootEntry) {
  return new Promise((resolve, reject) => {
    const out = [];
    const walk = (entry, prefix) => {
      if (entry.isFile) {
        entry.file(f => out.push(adapt(prefix ? prefix + "/" + entry.name : entry.name, f)),
                   e => reject(new Error(entry.name + ": " + e.name)));
      } else if (entry.isDirectory) {
        const reader = entry.createReader();
        const readBatch = () => reader.readEntries(async entries => {
          if (!entries.length) { resolve(out); return; }
          for (const en of entries) await walk(en, prefix ? prefix + "/" + entry.name : entry.name);
          readBatch();
        }, e => reject(new Error(entry.name + ": " + e.name)));
        readBatch();
      }
    };
    walk(rootEntry, "");
  });
}
function summarize(folder, list) {
  let bytes = 0, z = 0;
  for (const e of list) { bytes += e.size || 0; if (!e.size) z++; }
  return { folder, list, n: list.length, bytes, z };
}

/* ---------- 运行 ---------- */
$("#run").addEventListener("click", run);
async function run() {
  if (!state.A || !state.B) return;
  const runBtn = $("#run"); runBtn.disabled = true;
  const pw = $("#progwrap"), prog = $("#prog"), pl = $("#plabel");
  pw.hidden = false; pl.hidden = false; $("#status").textContent = "比对中…";
  const res = await runCompare(state.A.list, state.B.list, {
    algo: $("#algo").value,
    onProgress: (d, t, nm) => {
      prog.style.width = (t ? Math.round(d / t * 100) : 0) + "%";
      pl.textContent = "哈希 " + d + "/" + t + "：" + nm;
    },
  });
  prog.style.width = "100%";
  state.last = res; $("#status").textContent = "完成，耗时 " + (res.stats.ms / 1000).toFixed(1) + "s";
  runBtn.disabled = !(state.A && state.B);
  render(res);
}
function render(res) {
  const s = res.stats;
  $("#results").hidden = false;
  $("#rroots").textContent = "目录 A：" + (state.A ? state.A.folder : "") + "　·　目录 B：" + (state.B ? state.B.folder : "");
  const chips = [
    ["A 文件数", s.nA], ["B 文件数", s.nB],
    ["相同内容文件", s.nMatchA + " ↔ " + s.nMatchB],
    ["比对对数", s.nPairs + "（确定 " + s.nCertain + " / 推测 " + (s.nPairs - s.nCertain) + "）"],
    ["A 侧重复占用", humanSize(s.mbA)], ["B 侧重复占用", humanSize(s.mbB)],
    ["仅存在于 A", s.nOnlyA], ["仅存在于 B", s.nOnlyB],
    ["同名不同内容", s.nND], ["读取失败", s.nErr],
  ];
  $("#chips").innerHTML = chips.map(c =>
    "<div class='chip'><div class='v'>" + esc(c[1]) + "</div><div class='k'>" + esc(c[0]) + "</div></div>").join("");

  const pairRows = res.pairs.map(p => {
    if (p.a && p.b) {
      const bd = p.certain ? "<span class='b-certain'>确定</span>" : "<span class='b-guess'>推测</span>";
      const same = p.sameName ? "<span class='b-same'>同名</span>" : "";
      return "<tr><td>" + esc(p.a.name) + "</td><td>" + esc(p.b.name) + "</td><td>" + humanSize(p.a.size) + "</td><td>" + bd + same + "</td></tr>";
    }
    if (p.a) return "<tr><td>" + esc(p.a.name) + "</td><td class='dim'>（B 无对应份）</td><td>" + humanSize(p.a.size) + "</td><td><span class='b-only'>该侧多出</span></td></tr>";
    return "<tr><td class='dim'>（A 无对应份）</td><td>" + esc(p.b.name) + "</td><td>" + humanSize(p.b.size) + "</td><td><span class='b-only'>该侧多出</span></td></tr>";
  }).join("");
  const ndRows = res.namesDiff.map(x => "<tr><td>" + esc(x.a.name) + "</td><td>" + esc(x.b.name) + "</td><td>" + humanSize(x.a.size) + "</td><td>" + humanSize(x.b.size) + "</td></tr>").join("");
  const oaRows = res.onlyA.map(r => "<tr><td>" + esc(r.name) + "</td><td>" + humanSize(r.size) + "</td></tr>").join("");
  const obRows = res.onlyB.map(r => "<tr><td>" + esc(r.name) + "</td><td>" + humanSize(r.size) + "</td></tr>").join("");
  const erRows = res.errs.map(r => "<tr><td>" + esc(r.name) + "</td><td>" + esc(r.msg) + "</td></tr>").join("");
  const sec = (cls, title, badge, body, open, note) =>
    "<details class='sec'" + (open ? " open" : "") + "><summary><span class='t'>" + esc(title) + "</span>" +
    (note ? "<span class='note'>" + esc(note) + "</span>" : "") +
    "<span class='hbadge " + cls + "'>" + esc(badge) + "</span></summary>" + body + "</details>";
  const tbl = (hdr, rows, emptyCols, emptyTxt) =>
    "<div class='tblwrap'><table><thead><tr>" + hdr.map(h => "<th>" + esc(h) + "</th>").join("") + "</tr></thead><tbody>" +
    (rows || "<tr><td class='dim' colspan='" + emptyCols + "'>" + (emptyTxt || "（无）") + "</td></tr>") + "</tbody></table></div>";
  $("#secs").innerHTML =
    sec("ok", "相同内容匹配（谁等于谁）", s.nPairs, tbl(["目录A 文件", "目录B 文件", "大小", "判定"], pairRows, 4), true) +
    sec("warn", "⚠ 同名但内容不同（同名 ≠ 同一内容，覆盖前留意）", s.nND, tbl(["目录A 文件", "目录B 文件", "A 大小", "B 大小"], ndRows, 4), s.nND > 0) +
    sec("onlyA", "→ 仅存在于目录 A", s.nOnlyA, tbl(["文件", "大小"], oaRows, 2), false, "如需合并/清理，这些是 B 侧缺失的候选") +
    sec("onlyB", "→ 仅存在于目录 B", s.nOnlyB, tbl(["文件", "大小"], obRows, 2), false) +
    sec("err", "✘ 读取失败", s.nErr, tbl(["文件", "错误"], erRows, 2), false);
  $("#excsv").hidden = false;
}

$("#q").addEventListener("input", e => {
  const t = e.target.value.trim().toLowerCase();
  document.querySelectorAll("details.sec").forEach(d => {
    let vis = 0, tot = 0;
    d.querySelectorAll("tbody tr").forEach(tr => {
      tot++;
      const hit = !t || tr.textContent.toLowerCase().includes(t);
      tr.classList.toggle("hide", !hit);
      if (hit) vis++;
    });
    const b = d.querySelector(".hbadge");
    if (t && b && tot) b.textContent = vis + "/" + tot;
  });
});

$("#excsv").addEventListener("click", () => {
  const res = state.last; if (!res) return;
  const rows = [["判定", "目录A 相对路径", "目录B 相对路径", "大小"]];
  for (const p of res.pairs) {
    if (p.a && p.b) rows.push([p.certain ? "确定" : "推测(排序建议)", p.a.name, p.b.name, p.a.size]);
    else if (p.a) rows.push(["A 侧多出", p.a.name, "", p.a.size]);
    else rows.push(["B 侧多出", "", p.b.name, p.b.size]);
  }
  for (const x of res.namesDiff) rows.push(["同名不同内容", x.a.name, x.b.name, x.a.size]);
  for (const r of res.onlyA) rows.push(["仅A", r.name, "", r.size]);
  for (const r of res.onlyB) rows.push(["仅B", "", r.name, r.size]);
  const csv = "\uFEFF" + rows.map(r => r.map(v => {
    v = String(v == null ? "" : v);
    return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
  }).join(",")).join("\r\n");
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" }));
  a.download = "dircompare结果_" + new Date().toISOString().slice(0, 19).replace(/[:T]/g, "-") + ".csv";
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 3000);
});

/* ---------- 自检（?selftest=1） ---------- */
if (location.search.indexOf("selftest") >= 0) {
  (async () => {
    const out = $("#stout"); out.style.display = "block";
    const mk = (name, data) => {
      let u;
      if (data instanceof ArrayBuffer) { u = new Uint8Array(data); }
      else { const s = String(data); u = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) u[i] = s.charCodeAt(i) & 255; }
      return { name, size: u.length, read: () => Promise.resolve(u.buffer) };
    };
    const rep = (s, n) => Array(n).fill(s).join("");
    const big = new Uint8Array(3 * 1024 * 1024 + 777);
    for (let i = 0; i < big.length; i++) big[i] = (i * 7 + (i >> 3)) & 255;
    const bigOnly = big.slice(); bigOnly[bigOnly.length >> 1] ^= 0x55;
    const E = [];
    const push = (side, arr) => arr.forEach(e => E.push([side, e]));
    push("A", [mk("same.jpg", rep("samesame", 500)), mk("a1.jpg", rep("renamed content xyz", 300)), mk("clash.jpg", rep("A", 12)),
               mk("only_a.txt", "only-a"), mk("sub/deep1.jpg", rep("deep content ", 40)), mk("sA.jpg", rep("A", 100)),
               mk("bigA.bin", big.buffer), mk("dup1.jpg", rep("dup-content", 60)), mk("dup2.jpg", rep("dup-content", 60)), mk("zero.txt", "")]);
    push("B", [mk("same.jpg", rep("samesame", 500)), mk("b9.jpg", rep("renamed content xyz", 300)), mk("clash.jpg", rep("B", 12)),
               mk("only_b.txt", "only-b"), mk("sub2/deep1.jpg", rep("deep content ", 40)), mk("sB.jpg", rep("B", 100)),
               mk("bigB.bin", big.buffer), mk("big_only.bin", bigOnly.buffer), mk("dup3.jpg", rep("dup-content", 60)), mk("zero.txt", "")]);
    const A = E.filter(x => x[0] === "A").map(x => x[1]), B = E.filter(x => x[0] === "B").map(x => x[1]);
    const res = await runCompare(A, B, { algo: "SHA-256" });
    const s = res.stats;
    const ok1 = [s.nA, s.nB, s.zA, s.zB, s.nMatchA, s.nMatchB, s.nPairs, s.nCertain, s.nOnlyA, s.nOnlyB, s.nND, s.nErr]
      .join(",") === "9,9,1,1,6,5,5,4,3,4,1,0";
    const ok2 = res.pairs.some(p => p.a && p.b && p.a.name === "a1.jpg" && p.b.name === "b9.jpg" && p.certain);
    const ok3 = res.pairs.some(p => !p.a && p.b && p.b.name === "big_only.bin") === false; // big_only 应在 仅B 而非配对里
    const ok4 = res.onlyB.some(r => r.name === "big_only.bin");
    const ok5 = res.namesDiff.length === 1 && res.namesDiff[0].a.name === "clash.jpg";
    const pass = ok1 && ok2 && ok3 && ok4 && ok5;
    out.textContent = "自检 " + (pass ? "PASS ✓" : "FAIL ✗") +
      "\nstats=" + JSON.stringify(s) + "\nchecks: 统计=" + ok1 + " a1↔b9确定=" + ok2 + " big_only不在配对=" + ok3 +
      " big_only在仅B=" + ok4 + " clash同名不同=" + ok5 +
      "\npairs=" + JSON.stringify(res.pairs.map(p => [(p.a ? p.a.name : "∅"), (p.b ? p.b.name : "∅"), p.certain ? "确定" : "推测"])) +
      "\n仅A=" + res.onlyA.map(r => r.name).join(",") + "\n仅B=" + res.onlyB.map(r => r.name).join(",");
    document.title = (pass ? "SELFTEST PASS" : "SELFTEST FAIL") + " dircompare";
  })();
} else {
  document.querySelectorAll(".zone").forEach(z => {});
}
</script>
</body>
</html>
